# Hosting estático (Hostinger/Apache): las rutas de React Router caen en index.html
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>

# El shell y el service worker nunca se cachean, para que el autoUpdate de la PWA vea la versión nueva
<FilesMatch "^(index\.html|sw\.js|registerSW\.js|manifest\.webmanifest)$">
  <IfModule mod_headers.c>
    Header set Cache-Control "no-cache, no-store, must-revalidate"
  </IfModule>
</FilesMatch>
